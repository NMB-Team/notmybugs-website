{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "npm: dev",
			"type": "shell",
			"command": "npm",
			"args": ["run", "dev", "--", "--port", "5173", "--strictPort"],
			"windows": {
				"command": "npm.cmd"
			},
			"isBackground": true,
			"problemMatcher": {
				"owner": "vite",
				"pattern": {
					"regexp": "^(?!)()()()$",
					"file": 1,
					"line": 2,
					"message": 3
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "VITE",
					"endsPattern": "Local:.*http://localhost:5173/"
				}
			}
		},
		{
			"label": "Build NMB Team site",
			"type": "npm",
			"script": "build",
			"group": "build",
			"problemMatcher": "$tsc"
		},
		{
			"label": "Preview NMB Team site",
			"type": "shell",
			"command": "npm",
			"args": ["run", "preview", "--", "--open"],
			"windows": {
				"command": "npm.cmd"
			},
			"problemMatcher": []
		}
	]
}
